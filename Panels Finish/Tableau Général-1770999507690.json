          "datasource": {
            "type": "influxdb",
            "uid": "deoffyxtkywaoa"
          },
          "query": "// On définit la plage de temps dans une variable pour plus de clarté\r\ntime_range = -30m\r\n\r\n// --- SOURCE 1 : ANCIEN BUCKET (monitoring) ---\r\nsrc1 = from(bucket: \"monitoring\")\r\n  |> range(start: time_range)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"pc\")\r\n  // Intégration de la variable company\r\n  |> filter(fn: (r) => r[\"company\"] =~ /^${company:regex}$/)\r\n  |> filter(fn: (r) =>\r\n    r[\"_field\"] == \"release\" or \r\n    r[\"_field\"] == \"build_number\" or\r\n    r[\"_field\"] == \"anydesk_id\" or \r\n    r[\"_field\"] == \"bytes_recv\" or \r\n    r[\"_field\"] == \"bytes_sent\" or \r\n    r[\"_field\"] == \"cpu_percent\" or \r\n    r[\"_field\"] == \"disk_free\" or \r\n    r[\"_field\"] == \"disk_percent\" or \r\n    r[\"_field\"] == \"disk_total\" or \r\n    r[\"_field\"] == \"memory_percent\" or \r\n    r[\"_field\"] == \"memory_free\" or \r\n    r[\"_field\"] == \"memory_total\" or \r\n    r[\"_field\"] == \"pending_updates\" or \r\n    r[\"_field\"] == \"uptime_minutes\"\r\n  )\r\n  |> last() \r\n  |> map(fn: (r) => ({ r with _value: string(v: r._value) }))\r\n\r\n// --- SOURCE 2 : NOUVEAU BUCKET (BucketMonitoring) ---\r\nsrc2 = from(bucket: \"BucketMonitoring\")\r\n  |> range(start: time_range)\r\n  // Intégration de la variable company ici aussi\r\n  |> filter(fn: (r) => r[\"company\"] =~ /^${company:regex}$/)\r\n  |> filter(fn: (r) =>\r\n    r[\"_field\"] == \"agent_version\" or\r\n    r[\"_field\"] == \"release\" or \r\n    r[\"_field\"] == \"build_number\" or\r\n    r[\"_field\"] == \"anydesk_id\" or \r\n    r[\"_field\"] == \"bytes_recv\" or \r\n    r[\"_field\"] == \"bytes_sent\" or \r\n    r[\"_field\"] == \"cpu_percent\" or \r\n    r[\"_field\"] == \"memory_percent\" or \r\n    r[\"_field\"] == \"memory_free\" or \r\n    r[\"_field\"] == \"memory_total\" or \r\n    r[\"_field\"] == \"pending_updates\" or \r\n    r[\"_field\"] == \"uptime_minutes\" or\r\n    r[\"_field\"] == \"percent\" or \r\n    r[\"_field\"] == \"total\" or\r\n    r[\"_field\"] == \"read_bytes_sec\" or \r\n    r[\"_field\"] == \"write_bytes_sec\"\r\n  )\r\n  |> last() \r\n  |> map(fn: (r) => ({ r with \r\n      _field: \r\n        if r._measurement == \"disk\" then r.mountpoint + \"_\" + r._field \r\n        else if r._measurement == \"diskio\" then r.device + \"_\" + r._field\r\n        else r._field,\r\n      _value: string(v: r._value)\r\n  }))\r\n\r\n// --- FUSION ET NETTOYAGE DES DOUBLONS ---\r\nunion(tables: [src1, src2])\r\n  // On groupe par host et par field pour isoler les doublons de mesures\r\n  |> group(columns: [\"host\", \"company\", \"_field\"])\r\n  // On ne garde que la donnée la plus récente physiquement entre les deux buckets\r\n  |> last() \r\n  \r\n  // --- PIVOT FINAL ---\r\n  // On regroupe par host pour préparer le pivot (une ligne par PC)\r\n  |> group(columns: [\"host\", \"company\"])\r\n  |> pivot(rowKey: [\"host\", \"company\"], columnKey: [\"_field\"], valueColumn: \"_value\")\r\n  |> group()\r\n  |> yield(name: \"final_table\")",
          "refId": "A"
        }
      ],
