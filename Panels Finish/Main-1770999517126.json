          "query": "// Source 1\r\nsrc1 = from(bucket: \"monitoring\")\r\n  |> range(start: v.timeRangeStart)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"percent\")\r\n  |> last()\r\n  // MODIFICATION ICI : On retire \"r.host + ' - '\"\r\n  |> map(fn: (r) => ({ r with display_name: r.disk + \"://\" }))\r\n\r\n// Source 2\r\nsrc2 = from(bucket: \"BucketMonitoring\")\r\n  |> range(start: v.timeRangeStart)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == \"disk\" and r[\"_field\"] == \"percent\")\r\n  |> last()\r\n  // MODIFICATION ICI : On retire \"r.host + ' - '\"\r\n  |> map(fn: (r) => ({ r with display_name: r.mountpoint + \" (\" + r.device + \")\" }))\r\n\r\nunion(tables: [src1, src2])\r\n  |> group()\r\n  |> sort(columns: [\"_value\"], desc: true)\r\n  |> limit(n: int(v: \"${limit}\"))\r\n\r\n  |> keep(columns: [\"_time\", \"_value\", \"display_name\", \"host\"]) \r\n  |> rename(columns: {_value: \"Occupation (%)\", display_name: \"Détails\"})",
