      "targets": [
        {
          "query": "calcOffTime = (bkt, meas) => from(bucket: bkt)\r\n  |> range(start: -7d)\r\n  |> filter(fn: (r) => r[\"_measurement\"] == meas and r[\"_field\"] == \"uptime_minutes\")\r\n  |> group(columns: [\"host\"])\r\n  |> last()\r\n  |> map(fn: (r) => ({\r\n    host: r.host,\r\n    last_seen: r._time \r\n  }))\r\n\r\n// Union des résultats des deux buckets\r\nunion(tables: [\r\n  calcOffTime(bkt: \"monitoring\", meas: \"pc\"),\r\n  calcOffTime(bkt: \"BucketMonitoring\", meas: \"system\")\r\n])\r\n  // --- CRUCIAL : On regroupe par host pour fusionner les deux buckets ---\r\n  |> group(columns: [\"host\"])\r\n  |> max(column: \"last_seen\") // On garde la date la plus récente entre les deux buckets\r\n  \r\n  // --- Calcul final après avoir choisi le bucket le plus récent ---\r\n  |> map(fn: (r) => ({\r\n    host: r.host,\r\n    minutes_ago: float(v: (uint(v: now()) - uint(v: r.last_seen)) / uint(v: 60000000000))\r\n  }))\r\n  \r\n  // --- Filtre final : Uniquement si le PC est absent des DEUX buckets depuis > 5 min ---\r\n  |> filter(fn: (r) => r.minutes_ago >= 5.0)\r\n  |> keep(columns: [\"host\", \"minutes_ago\"])\r\n  |> group()",
          "refId": "A"
        }
      ],
      "title": "OFF_TIME",
      "type": "stat"
    },
