            "uid": "aenfalcuf083ka"
          },
          "query": "target = \"${type_donnee}\"\r\n\r\n// --- SOURCE 1 : ANCIEN BUCKET (monitoring) ---\r\nsrc1 = from(bucket: \"monitoring\")\r\n  |> range(start: -5m) \r\n  |> filter(fn: (r) => \r\n    (target == \"cpu\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"cpu_percent\") or\r\n    (target == \"ram\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"memory_percent\") or\r\n    (target == \"disk\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"percent\") or \r\n    (target == \"read\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"read_bytes\") or\r\n    (target == \"write\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"write_bytes\") or\r\n    (target == \"recv\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"bytes_recv\") or\r\n    (target == \"sent\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"bytes_sent\") or\r\n    (target == \"updates\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"pending_updates\") or\r\n    (target == \"uptime\" and r[\"_measurement\"] == \"pc\" and r[\"_field\"] == \"uptime_minutes\")\r\n  )\r\n  |> last()\r\n  |> map(fn: (r) => ({ \r\n      r with \r\n      host_link: r.host, // Colonne propre pour le Data Link\r\n      host: if target == \"disk\" or target == \"read\" or target == \"write\" \r\n           then r.host + \" - \" + r.disk + \"://\" \r\n           else r.host \r\n  }))\r\n\r\n// --- SOURCE 2 : NOUVEAU BUCKET (BucketMonitoring) ---\r\nsrc2 = from(bucket: \"BucketMonitoring\")\r\n  |> range(start: -5m)\r\n  |> filter(fn: (r) => \r\n    (target == \"cpu\" and r[\"_measurement\"] == \"cpu\" and r[\"_field\"] == \"cpu_percent\") or\r\n    (target == \"ram\" and r[\"_measurement\"] == \"memory\" and r[\"_field\"] == \"memory_percent\") or\r\n    (target == \"disk\" and r[\"_measurement\"] == \"disk\" and (r[\"_field\"] == \"used_percent\" or r[\"_field\"] == \"percent\")) or \r\n    (target == \"read\" and r[\"_measurement\"] == \"diskio\" and (r[\"_field\"] == \"read_bytes_sec\" or r[\"_field\"] == \"read_bytes\")) or\r\n    (target == \"write\" and r[\"_measurement\"] == \"diskio\" and (r[\"_field\"] == \"write_bytes_sec\" or r[\"_field\"] == \"write_bytes\")) or\r\n    (target == \"recv\" and r[\"_measurement\"] == \"network\" and r[\"_field\"] == \"bytes_recv\") or\r\n    (target == \"sent\" and r[\"_measurement\"] == \"network\" and r[\"_field\"] == \"bytes_sent\") or\r\n    (target == \"updates\" and r[\"_measurement\"] == \"updates\" and r[\"_field\"] == \"pending_updates\") or\r\n    (target == \"uptime\" and r[\"_measurement\"] == \"system\" and r[\"_field\"] == \"uptime_minutes\")\r\n  )\r\n  |> last()\r\n  |> map(fn: (r) => ({ \r\n      r with \r\n      host_link: r.host, // Colonne propre pour le Data Link\r\n      host: if target == \"disk\" or target == \"read\" or target == \"write\" \r\n           then r.host + \" - \" + (if exists r.mountpoint then r.mountpoint else \"\") + \" (\" + r.device + \")\" \r\n           else r.host \r\n  }))\r\n\r\n// --- FUSION ET RENAME ---\r\nunion(tables: [src1, src2])\r\n  |> group() \r\n  // On prépare le nom technique du champ pour les Overrides\r\n  |> map(fn: (r) => ({ r with _field: if target == \"disk\" then \"usage_disk\" else target })) \r\n  |> sort(columns: [\"_value\"], desc: true)\r\n  |> limit(n: ${limit})\r\n  |> rename(columns: {\"_value\": if target == \"disk\" then \"usage_disk\" else target})",
          "refId": "A"
        }
      ],
      "title": "${type_donnee} ",
      "type": "stat"
    }
